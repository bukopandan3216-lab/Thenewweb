# Server
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
 
# Database
DB_HOST=localhost
DB_PORT=3306 //Previous value: 3306
DB_USER=root
DB_PASSWORD=
